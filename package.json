{
  "name": "commuteradar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A lightweight, local-first PWA for tracking recurring commutes (bike, run, walk, train) without a full mapping stack.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "idb": "8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "jsdom": "24.1.0",
    "typescript": "5.5.3",
    "vite": "5.3.3",
    "vite-plugin-pwa": "0.20.0",
    "vitest": "1.6.0"
  }
}
